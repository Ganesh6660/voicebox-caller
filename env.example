# Plivo (console.plivo.com -> Overview, for auth_id/auth_token;
# Phone Numbers for the number you bought)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=+9198XXXXXXX

# Your machine's public HTTPS URL for server.py, e.g. an ngrok tunnel.
# Set this AFTER starting ngrok, before running place_call.py.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Voicebox, running locally
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_VOICE_ID=your-cloned-voice-id

# LLM
ANTHROPIC_API_KEY=
# Defaults to Haiku (cheap, fine for triage). Override with a Sonnet model ID
# for calls that need the AI to carry more of the conversation itself.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# AI + human handoff (see "AI + human hybrid" in server.py / README.md)
# Where a verified caller gets transferred, E.164 format.
HUMAN_PHONE_NUMBER=+9198XXXXXXX

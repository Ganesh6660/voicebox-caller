# Twilio (twilio.com console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Your machine's public HTTPS URL for server.py, e.g. an ngrok tunnel.
# Set this AFTER starting ngrok, before running place_call.py.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Voicebox, running locally
VOICEBOX_BASE_URL=http://127.0.0.1:17493
# This is a Voicebox *profile* id (POST /profiles, or one made in the app),
# not a raw preset voice_id — /generate takes profile_id.
VOICEBOX_VOICE_ID=your-voicebox-profile-id

# LLM (OpenRouter — proxies many models behind one OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.7:free

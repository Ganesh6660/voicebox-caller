# Plivo (console.plivo.com -> Overview, for auth_id/auth_token;
# Phone Numbers for the number you bought). Used by both place_call.py (to
# place the call) and server.py (to send the handoff SMS and transfer the
# live call to HUMAN_PHONE_NUMBER — see notify_human()/transfer_call_to_human()).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=+9198XXXXXXX

# Your machine's public HTTPS URL for server.py, e.g. an ngrok tunnel.
# Set this AFTER starting ngrok, before running place_call.py.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Voicebox, running locally. VOICEBOX_VOICE_ID is a *profile_id* from
# Voicebox's /profiles (POST /profiles with voice_type="cloned" for your own
# voice, or voice_type="preset"+preset_engine+preset_voice_id to use one of
# its built-in voices, e.g. Kokoro's, with no recording needed). VOICEBOX_ENGINE
# should match whichever engine that profile uses; kokoro/luxtts are the
# CPU-friendly engines if you don't have a GPU — the API defaults to the
# GPU-oriented "qwen" otherwise.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_VOICE_ID=your-voicebox-profile-id
VOICEBOX_ENGINE=kokoro

# LLM — set ONE of these two. If OPENROUTER_API_KEY is present, server.py uses
# OpenRouter; otherwise it falls back to Anthropic direct. Both default to a
# cheap/fast model since this role is triage (verify + decide), not deep
# reasoning — override with a bigger model for calls that need more.

# OpenRouter (openrouter.ai/keys). Model must support tool/function calling —
# check openrouter.ai/models. anthropic/claude-haiku-4.5 is the OpenRouter
# equivalent of the Anthropic-direct default below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Anthropic direct (console.anthropic.com) — used only if OPENROUTER_API_KEY is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# AI + human handoff (see "AI + human hybrid" in server.py / README.md)
# Where a verified caller gets transferred, E.164 format.
HUMAN_PHONE_NUMBER=+9198XXXXXXX
